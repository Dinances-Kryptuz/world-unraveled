rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && request.auth.uid == uid;
      allow delete: if false;
    }

    match /characters/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;

      allow create: if request.auth != null
        && request.auth.uid == uid
        && isValidNewCharacter(request.resource.data);

      // The OR here is Phase 4's slot-swap allowance: isValidCharacterUpdate
      // covers ordinary play (same character, level/xp never regress);
      // isValidCharacterShape alone covers firebase/characterSlots.ts
      // replacing this doc's character entirely (a fresh level-1 roll, or
      // an archived character being restored to active) — a legitimate
      // write no "before" character's invariants could ever make sense
      // against. || short-circuits, so the ordinary (first) case costs
      // nothing extra — isValidCharacterShape only runs again when that one
      // fails, which only happens on an actual slot swap, never on a normal
      // combat/gather/craft autosave.
      allow update: if request.auth != null
        && request.auth.uid == uid
        && (isValidCharacterUpdate(resource.data, request.resource.data) || isValidCharacterShape(request.resource.data));

      allow delete: if false;

      match /inventory/{docId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow create: if request.auth != null && request.auth.uid == uid && request.resource.data.keys().hasOnly(['items', 'equipmentInstances', 'chargedConsumables', 'lockedInstanceIds']);
        allow update: if request.auth != null && request.auth.uid == uid && request.resource.data.keys().hasOnly(['items', 'equipmentInstances', 'chargedConsumables', 'lockedInstanceIds']);
        allow delete: if false;
      }

      // Same shape/rules as inventory above — a separate, larger storage
      // pool (gameData/bank.ts's nextBankSlotCost gates how big) rather than
      // a different document shape.
      match /bank/{docId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow create: if request.auth != null && request.auth.uid == uid && request.resource.data.keys().hasOnly(['items', 'equipmentInstances', 'chargedConsumables', 'lockedInstanceIds']);
        allow update: if request.auth != null && request.auth.uid == uid && request.resource.data.keys().hasOnly(['items', 'equipmentInstances', 'chargedConsumables', 'lockedInstanceIds']);
        allow delete: if false;
      }

      // Phase 4: every unlocked character slot OTHER than the currently-
      // active one (which lives at the parent characters/{uid} doc above) is
      // archived here in full, under firebase/characterSlots.ts's
      // archive/promote swap. Unlike the parent doc, these ARE deletable —
      // switchActiveCharacter clears a slot's roster copy the moment it's
      // promoted back to active, so a character's data only ever exists in
      // one place at a time. A roster doc is only ever written by that one
      // swap (never incrementally, the way ordinary play updates the active
      // character), so it only needs a basic shape check, not the full
      // isValidCharacterUpdate apparatus.
      match /roster/{slotId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.name is string
          && request.resource.data.class is string
          && request.resource.data.level is number;
        allow delete: if request.auth != null && request.auth.uid == uid;

        match /inventory/{docId} {
          allow read: if request.auth != null && request.auth.uid == uid;
          allow create, update: if request.auth != null && request.auth.uid == uid && request.resource.data.keys().hasOnly(['items', 'equipmentInstances', 'chargedConsumables', 'lockedInstanceIds']);
          allow delete: if request.auth != null && request.auth.uid == uid;
        }
        match /bank/{docId} {
          allow read: if request.auth != null && request.auth.uid == uid;
          allow create, update: if request.auth != null && request.auth.uid == uid && request.resource.data.keys().hasOnly(['items', 'equipmentInstances', 'chargedConsumables', 'lockedInstanceIds']);
          allow delete: if request.auth != null && request.auth.uid == uid;
        }
      }
    }

    // Phase 4: one tiny doc per account tracking which character slot is
    // currently live at characters/{uid} and how many are unlocked — see
    // gameData/characterSlots.ts/firebase/characterSlots.ts.
    match /accounts/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['unlockedSlots', 'activeSlot'])
        && request.resource.data.unlockedSlots == 1
        && request.resource.data.activeSlot == 1;
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['unlockedSlots', 'activeSlot'])
        && request.resource.data.unlockedSlots is number
        && request.resource.data.unlockedSlots >= resource.data.unlockedSlots
        && request.resource.data.unlockedSlots <= 3
        && request.resource.data.activeSlot is number
        && request.resource.data.activeSlot >= 1
        && request.resource.data.activeSlot <= request.resource.data.unlockedSlots;
      allow delete: if false;
    }

    // Player-submitted bug reports (see components/BugReportButton.tsx /
    // firebase/bugReports.ts) — deliberately create-only from the client:
    // nobody can read, edit, or delete another player's (or their own)
    // report once sent, only view them via the Firebase console. Allowed
    // signed-out too (the login screen itself can hit a bug before a
    // player ever authenticates), with `uid` required to match the caller
    // when one exists so a signed-in player can't spoof someone else's.
    match /bugReports/{reportId} {
      allow read, update, delete: if false;
      allow create: if isValidBugReport(request.resource.data)
        && ((request.auth == null && request.resource.data.uid == null)
          || (request.auth != null && request.resource.data.uid == request.auth.uid));
    }

    // Guild System (Capital City Phase 2+) — every write to these three
    // collections goes through a Cloud Function (functions/src/guilds.ts)
    // using the Admin SDK, which bypasses these rules entirely. Clients
    // only ever READ them directly: the full guild doc (membership/roles,
    // needed to render Guild Hall), the lightweight per-member roster rows
    // (so the member list never has to read every member's own full
    // character document), and the public discovery summaries (guild
    // browsing). None of these three is ever written client-side —
    // `allow write: if false` is permanent, not a placeholder.
    match /guilds/{guildId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /guildMembers/{memberDocId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /guildPublicSummaries/{guildId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // A single cached doc (id "top") rebuilt every few minutes by a
    // scheduled Cloud Function (functions/src/guildDiscoveryCache.ts) from
    // guildPublicSummaries — lets the Guild Hall's "browse guilds" list cost
    // ONE read instead of a 20-doc collection query every time a
    // non-guilded player opens it. Eventually consistent by design; the
    // client falls back to the live collection query if this doc is
    // missing (e.g. before the schedule's first run).
    match /guildDiscoveryCache/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Weekly Guild Contracts (functions/src/contracts.ts) — same posture as
    // the three collections above: every write (turn-ins, kill reports,
    // reward claims, companion contributions, week rollover) goes through
    // a Cloud Function; clients only ever read.
    match /guildWeeks/{weekDocId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Guild Expeditions (functions/src/expeditions.ts) — personal, not
    // guild-wide, so reads are scoped to the owner only (unlike the three
    // collections above, which every guild member may read). Every write
    // still goes through a Cloud Function.
    match /expeditions/{expeditionId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.ownerUid;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }

  function isValidBugReport(data) {
    return data.keys().hasOnly(['uid', 'email', 'message', 'page', 'userAgent', 'createdAt'])
      && (data.uid == null || (data.uid is string && data.uid.size() <= 128))
      && (data.email == null || (data.email is string && data.email.size() <= 254))
      && data.message is string && data.message.size() >= 1 && data.message.size() <= 2000
      && (data.page == null || (data.page is string && data.page.size() <= 100))
      && (data.userAgent == null || (data.userAgent is string && data.userAgent.size() <= 300))
      && data.createdAt == request.time;
  }

  function isValidNewCharacter(data) {
    return data.name is string && data.name.size() >= 2 && data.name.size() <= 20
      && data.level == 1
      && data.xp == 0
      && data.gold == 0
      && data.voidShards == 0
      && isValidNewEquipment(data.equipment)
      && data.professions == {}
      && data.enchantments == {}
      && data.learnedRecipeIds == []
      && data.bagSlots == 24
      && data.bankSlots == 4
      && data.activeBuffs == {}
      && data.equippedConsumables == { 'food': null, 'potion': null }
      && data.currentActivity.type == null
      && data.equippedAbilityIds == []
      && data.abilityConditions == {}
      && data.disabledAbilityIds == []
      && data.combatPresets == []
      && data.itemCooldowns == {}
      && isValidNewQuests(data.quests)
      && data.companions == {}
      && data.activeCompanionIds == []
      && data.activeAltSlots == []
      && data.dungeonClears == {}
      && data.discoveredZoneIds == ['greenhollow_fields']
      && data.collectedItemIds == []
      && data.unlockedAchievementIds == []
      && data.notificationsEnabled == true
      && data.skillXpNotificationsEnabled == false
      && data.masteryXpNotificationsEnabled == false
      && data.mounts == []
      && data.trainedAbilityIds == []
      && data.currentZoneId == 'greenhollow_fields'
      && data.travel == null;
  }

  // The ordinary-play case: the SAME character (name unchanged) just keeps
  // leveling/earning — level/xp can never regress, createdAt is fixed.
  // Phase 4 needs a second case (see isValidCharacterShape/the characters/
  // {uid} update rule below) for firebase/characterSlots.ts's archive/
  // promote swap, which legitimately OVERWRITES this doc with a different
  // character (a fresh level-1 roll, or an older archived one being
  // restored) — neither of which could ever satisfy "level never decreases"
  // relative to whoever occupied the slot before.
  function isValidCharacterUpdate(before, after) {
    return after.name == before.name
      && after.createdAt == before.createdAt
      && after.level is number && after.level >= before.level
      && after.xp is number && after.xp >= before.xp
      // Guild membership is only ever granted/revoked by a Cloud Function
      // (functions/src/guilds.ts), which writes via the Admin SDK and so
      // bypasses these rules entirely — an ordinary client autosave may
      // only ever carry this field through UNCHANGED, never introduce or
      // clear it itself. (guildId is still just a convenience pointer for
      // the client's own UI — every guild mutation re-derives the caller's
      // real membership/role from the guilds/guildMembers documents
      // server-side, never from this field, so even a forged value here
      // can't grant any actual guild permission.)
      && (('guildId' in before) == ('guildId' in after))
      && (!('guildId' in before) || before.guildId == after.guildId)
      // Guild invites (Phase 7) — same Cloud-Function-only posture as
      // guildId above: inviteToGuild/acceptGuildInvite/declineGuildInvite
      // (functions/src/guilds.ts) are the only things that may set, clear,
      // or change these two fields; an ordinary client autosave may only
      // carry them through unchanged.
      && (('pendingGuildInviteId' in before) == ('pendingGuildInviteId' in after))
      && (!('pendingGuildInviteId' in before) || before.pendingGuildInviteId == after.pendingGuildInviteId)
      && (('pendingGuildInviteGuildName' in before) == ('pendingGuildInviteGuildName' in after))
      && (!('pendingGuildInviteGuildName' in before) || before.pendingGuildInviteGuildName == after.pendingGuildInviteGuildName)
      && isValidCharacterShape(after);
  }

  // Every check that applies no matter WHICH character occupies this slot —
  // split out from isValidCharacterUpdate so a Phase 4 slot-swap (a
  // different character's data entirely, where "level never decreases
  // relative to before" is meaningless) can still be held to the same
  // shape/bounds rules without the before/after comparisons.
  //
  // DELIBERATELY MINIMAL. Every optional field on Character (professions,
  // quests, companions, mastery tracks, titles, mounts, the Journal, …)
  // used to get its own "shape-only" validator function here, chained
  // unconditionally into this one — meaning EVERY SINGLE WRITE to this
  // document (every combat/gather/craft/profession autosave, for every
  // player) re-evaluated the full chain regardless of which field actually
  // changed. That design has now broken production three times as the
  // game added more optional fields and players' own characters grew more
  // complete: a character with full gear (isValidEquipment's per-slot
  // branching), then a character with several known professions
  // (isValidProfessions' per-entry descent), and most recently an
  // ordinarily-veteran character (10 known professions, several
  // companions, dozens of achievements/titles, mastery progress on every
  // tracked axis) tripped Firestore's hard 1000-expression-per-request
  // rules evaluation ceiling on a completely ordinary xp/gold autosave —
  // "insufficient permissions" on every action (combat, gathering,
  // crafting, training) for any character whose OWN data had simply grown
  // large enough, with no code change needed to trigger it. The first two
  // incidents were each fixed by shrinking one validator to a single
  // expression; neither fix addressed the actual cause (summing ~45
  // unconditional per-field checks on every write), so the same failure
  // mode kept recurring as more fields were added.
  //
  // The fields no longer checked here are all single-player state with no
  // cross-player stakes: this is a single-player idle/RPG with no PvP,
  // leaderboard, or shared economy — a forged or malformed value in any of
  // them can only corrupt the WRITER'S OWN character, the same as editing
  // your own save file. The one field that genuinely crosses into shared
  // state, guildId, stays protected above in isValidCharacterUpdate (cheap
  // regardless, so no budget tradeoff there). Every consequential mutation
  // elsewhere — granting gold/items, unlocking a profession/ability,
  // guild contract rewards — is independently validated by its own writer
  // function in src/firebase/*.ts (re-checked server-side via Cloud
  // Functions wherever a cross-player stake exists, e.g. functions/src/
  // guilds.ts and contracts.ts) before it ever calls updateDoc; that write
  // path, not this rules file, was always the real enforcement point for
  // those invariants. What's left here is the minimum needed to keep every
  // reader of this document (every screen in the app) from choking on a
  // structurally broken write.
  function isValidCharacterShape(after) {
    return after.name is string && after.name.size() >= 2 && after.name.size() <= 20
      && after.level is number && after.level >= 1
      && after.xp is number && after.xp >= 0
      && after.gold is number && after.gold >= 0
      && after.voidShards is number && after.voidShards >= 0
      && isValidEquipment(after.equipment);
  }

  // Ownership-scoped, not fully value-scoped — same posture as the sibling
  // maps below. Full validation (e.g. that a slot's value is a real
  // equippable item id the class can wear) happens in firebase/character.ts's
  // equipItem before the write is even sent. Deliberately NOT checking each
  // of the 7 slots individually with a per-field null-or-string branch: with
  // every slot non-null (a fully-geared character, the normal end state of
  // real play) that per-field branching was enough to trip Firestore's
  // 1000-expression-per-request rules evaluation limit on every single
  // combat/gather/craft autosave — a real, production-blocking bug, not an
  // emulator artifact (the first of the three incidents described in
  // isValidCharacterShape's own comment above).
  function isValidEquipment(e) {
    return e is map && e.keys().hasOnly([
      'weapon','offhand','chest','helmet','gloves','legs','boots','ring','ring2','necklace','tool',
      'shoulders','cape','shirt','tabard','bracers','belt','ammo'
    ]);
  }

  // weapon/chest/boots may already be filled at creation — createCharacter()
  // grants a small class-appropriate starter kit there (see gameData/items.ts's
  // "Starter gear" section) so a level-1 character isn't fighting bare-handed.
  // The remaining slots (helmet/gloves/legs/ring/ring2/necklace/offhand/tool)
  // the starter kit never touches, so those must still be empty on a
  // genuinely new character.
  function isValidNewEquipment(e) {
    return isValidEquipment(e)
      && e.helmet == null && e.gloves == null && e.legs == null && e.ring == null && e.ring2 == null
      && e.necklace == null && e.offhand == null && e.tool == null
      && e.shoulders == null && e.cape == null && e.shirt == null && e.tabard == null
      && e.bracers == null && e.belt == null && e.ammo == null;
  }

  // New-character quests: completedIds/dailyCompletedAt must be empty (a
  // fresh character has completed nothing yet), but active may already
  // hold up to MAX_ACTIVE_QUESTS starter quests — createCharacter() fills
  // it via refillActiveQuests() before the write, so a brand new character
  // sees its quest board immediately instead of an empty one. Only runs
  // once, at character creation, so this is not part of the expression-
  // budget pressure described on isValidCharacterShape above.
  function isValidNewQuests(q) {
    return q is map
      && q.keys().hasOnly(['active', 'completedIds', 'dailyCompletedAt'])
      && q.active is map && q.active.size() <= 8
      && q.completedIds == []
      && q.dailyCompletedAt == {};
  }
}
