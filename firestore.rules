rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && request.auth.uid == uid;
      allow delete: if false;
    }

    match /characters/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;

      allow create: if request.auth != null
        && request.auth.uid == uid
        && isValidNewCharacter(request.resource.data);

      // The OR here is Phase 4's slot-swap allowance: isValidCharacterUpdate
      // covers ordinary play (same character, level/xp never regress);
      // isValidCharacterShape alone covers firebase/characterSlots.ts
      // replacing this doc's character entirely (a fresh level-1 roll, or
      // an archived character being restored to active) — a legitimate
      // write no "before" character's invariants could ever make sense
      // against. || short-circuits, so the ordinary (first) case costs
      // nothing extra — isValidCharacterShape only runs again when that one
      // fails, which only happens on an actual slot swap, never on a normal
      // combat/gather/craft autosave.
      allow update: if request.auth != null
        && request.auth.uid == uid
        && (isValidCharacterUpdate(resource.data, request.resource.data) || isValidCharacterShape(request.resource.data));

      allow delete: if false;

      match /inventory/{docId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow create: if request.auth != null && request.auth.uid == uid && request.resource.data.keys().hasOnly(['items']);
        allow update: if request.auth != null && request.auth.uid == uid && request.resource.data.keys().hasOnly(['items']);
        allow delete: if false;
      }

      // Same shape/rules as inventory above — a separate, larger storage
      // pool (gameData/bank.ts's nextBankSlotCost gates how big) rather than
      // a different document shape.
      match /bank/{docId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow create: if request.auth != null && request.auth.uid == uid && request.resource.data.keys().hasOnly(['items']);
        allow update: if request.auth != null && request.auth.uid == uid && request.resource.data.keys().hasOnly(['items']);
        allow delete: if false;
      }

      // Phase 4: every unlocked character slot OTHER than the currently-
      // active one (which lives at the parent characters/{uid} doc above) is
      // archived here in full, under firebase/characterSlots.ts's
      // archive/promote swap. Unlike the parent doc, these ARE deletable —
      // switchActiveCharacter clears a slot's roster copy the moment it's
      // promoted back to active, so a character's data only ever exists in
      // one place at a time. A roster doc is only ever written by that one
      // swap (never incrementally, the way ordinary play updates the active
      // character), so it only needs a basic shape check, not the full
      // isValidCharacterUpdate apparatus.
      match /roster/{slotId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.name is string
          && request.resource.data.class is string
          && request.resource.data.level is number;
        allow delete: if request.auth != null && request.auth.uid == uid;

        match /inventory/{docId} {
          allow read: if request.auth != null && request.auth.uid == uid;
          allow create, update: if request.auth != null && request.auth.uid == uid && request.resource.data.keys().hasOnly(['items']);
          allow delete: if request.auth != null && request.auth.uid == uid;
        }
        match /bank/{docId} {
          allow read: if request.auth != null && request.auth.uid == uid;
          allow create, update: if request.auth != null && request.auth.uid == uid && request.resource.data.keys().hasOnly(['items']);
          allow delete: if request.auth != null && request.auth.uid == uid;
        }
      }
    }

    // Phase 4: one tiny doc per account tracking which character slot is
    // currently live at characters/{uid} and how many are unlocked — see
    // gameData/characterSlots.ts/firebase/characterSlots.ts.
    match /accounts/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['unlockedSlots', 'activeSlot'])
        && request.resource.data.unlockedSlots == 1
        && request.resource.data.activeSlot == 1;
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['unlockedSlots', 'activeSlot'])
        && request.resource.data.unlockedSlots is number
        && request.resource.data.unlockedSlots >= resource.data.unlockedSlots
        && request.resource.data.unlockedSlots <= 3
        && request.resource.data.activeSlot is number
        && request.resource.data.activeSlot >= 1
        && request.resource.data.activeSlot <= request.resource.data.unlockedSlots;
      allow delete: if false;
    }

    // Player-submitted bug reports (see components/BugReportButton.tsx /
    // firebase/bugReports.ts) — deliberately create-only from the client:
    // nobody can read, edit, or delete another player's (or their own)
    // report once sent, only view them via the Firebase console. Allowed
    // signed-out too (the login screen itself can hit a bug before a
    // player ever authenticates), with `uid` required to match the caller
    // when one exists so a signed-in player can't spoof someone else's.
    match /bugReports/{reportId} {
      allow read, update, delete: if false;
      allow create: if isValidBugReport(request.resource.data)
        && ((request.auth == null && request.resource.data.uid == null)
          || (request.auth != null && request.resource.data.uid == request.auth.uid));
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }

  function isValidBugReport(data) {
    return data.keys().hasOnly(['uid', 'email', 'message', 'page', 'userAgent', 'createdAt'])
      && (data.uid == null || (data.uid is string && data.uid.size() <= 128))
      && (data.email == null || (data.email is string && data.email.size() <= 254))
      && data.message is string && data.message.size() >= 1 && data.message.size() <= 2000
      && (data.page == null || (data.page is string && data.page.size() <= 100))
      && (data.userAgent == null || (data.userAgent is string && data.userAgent.size() <= 300))
      && data.createdAt == request.time;
  }

  function isValidNewCharacter(data) {
    return data.name is string && data.name.size() >= 2 && data.name.size() <= 20
      && data.level == 1
      && data.xp == 0
      && data.gold == 0
      && data.voidShards == 0
      && isValidNewEquipment(data.equipment)
      && data.professions == {}
      && data.enchantments == {}
      && data.learnedRecipeIds == []
      && data.bagSlots == 24
      && data.bankSlots == 4
      && data.activeBuffs == {}
      && data.currentActivity.type == null
      && data.equippedAbilityIds == []
      && data.abilityConditions == {}
      && data.disabledAbilityIds == []
      && data.combatPresets == []
      && data.itemCooldowns == {}
      && isValidNewQuests(data.quests)
      && data.companions == {}
      && data.activeCompanionIds == []
      && data.activeAltSlots == []
      && data.dungeonClears == {}
      && data.collectedItemIds == []
      && data.unlockedAchievementIds == []
      && data.notificationsEnabled == true
      && data.currentZoneId == 'greenhollow_fields'
      && data.travel == null;
  }

  // The ordinary-play case: the SAME character (name unchanged) just keeps
  // leveling/earning — level/xp can never regress, createdAt is fixed.
  // Phase 4 needs a second case (see isValidCharacterShape/the characters/
  // {uid} update rule below) for firebase/characterSlots.ts's archive/
  // promote swap, which legitimately OVERWRITES this doc with a different
  // character (a fresh level-1 roll, or an older archived one being
  // restored) — neither of which could ever satisfy "level never decreases"
  // relative to whoever occupied the slot before.
  function isValidCharacterUpdate(before, after) {
    return after.name == before.name
      && after.createdAt == before.createdAt
      && after.level is number && after.level >= before.level
      && after.xp is number && after.xp >= before.xp
      && isValidCharacterShape(after);
  }

  // Every check that applies no matter WHICH character occupies this slot —
  // split out from isValidCharacterUpdate so a Phase 4 slot-swap (a
  // different character's data entirely, where "level never decreases
  // relative to before" is meaningless) can still be held to the same
  // shape/bounds rules without the before/after comparisons.
  function isValidCharacterShape(after) {
    return after.name is string && after.name.size() >= 2 && after.name.size() <= 20
      && after.level is number && after.level >= 1
      && after.xp is number && after.xp >= 0
      && after.gold is number && after.gold >= 0
      && after.voidShards is number && after.voidShards >= 0
      && isValidEquipment(after.equipment)
      && isValidProfessions(after.professions)
      && isValidEnchantments(after)
      && isValidLearnedRecipeIds(after)
      && isValidBagSlots(after)
      && isValidBankSlots(after)
      && isValidActiveBuffs(after)
      && isValidActivity(after.currentActivity)
      && isValidEquippedAbilityIds(after)
      && isValidAbilityConditions(after)
      && isValidDisabledAbilityIds(after)
      && isValidCombatPresets(after)
      && isValidItemCooldowns(after)
      && isValidQuests(after)
      && isValidCompanions(after)
      && isValidActiveCompanionIds(after)
      && isValidCurrentZoneId(after)
      && isValidTravel(after)
      && isValidActiveAltSlots(after)
      && isValidDungeonClears(after)
      && isValidCollectedItemIds(after)
      && isValidUnlockedAchievementIds(after)
      && isValidNotificationsEnabled(after);
  }

  // Same "may not exist yet on an old character" treatment and expression-
  // budget-conscious posture as isValidCurrentZoneId above — full
  // validation (that a dungeon id is real, that the count only ever
  // increments) happens in firebase/character.ts's applyCombatResult, the
  // only path that writes this field.
  function isValidDungeonClears(after) {
    return !('dungeonClears' in after) || after.dungeonClears is map;
  }

  // Same treatment — full validation (that an id is a real equipment item,
  // that the list only ever grows) happens in
  // firebase/achievements.ts's reconcileCollectionAndAchievements, the only
  // path that writes this field.
  function isValidCollectedItemIds(after) {
    return !('collectedItemIds' in after) || after.collectedItemIds is list;
  }

  // Same treatment — full validation (that an id is a real achievement,
  // that the list only ever grows) happens in the same reconcile function
  // above, the only path that writes this field.
  function isValidUnlockedAchievementIds(after) {
    return !('unlockedAchievementIds' in after) || after.unlockedAchievementIds is list;
  }

  function isValidNotificationsEnabled(after) {
    return !('notificationsEnabled' in after) || after.notificationsEnabled is bool;
  }

  // Same "may not exist yet on an old character" treatment and ownership-
  // scoped posture as isValidActiveCompanionIds — full validation (that a
  // slot number is actually unlocked, has a roster character in it, and the
  // combined companions+alts count stays under the shared party-size limit)
  // happens in firebase/characterSlots.ts's addAltToParty, the only path
  // that ever adds an entry. One expression, not a size bound too — see
  // isValidCurrentZoneId's comment on this file's expression budget.
  function isValidActiveAltSlots(after) {
    return !('activeAltSlots' in after) || after.activeAltSlots is list;
  }

  // Optional like bagSlots/bankSlots above — a character that existed before
  // this field did has no currentZoneId in its raw document at all yet (see
  // firebase/character.ts's getCharacter(), which backfills it to
  // DEFAULT_ZONE_ID in memory without an eager write-back), and every one of
  // its ordinary updates (gaining xp, gold, etc.) must keep working without
  // ever having set it. Kept to one expression on purpose — see
  // isValidEquipment's comment on this file's 1000-expression-per-request
  // evaluation ceiling; a fully-populated character (gear, professions,
  // quests, companions) was already close to it before Phase 3/4 added
  // currentZoneId/travel/activeAltSlots, so each of these stays as cheap as
  // the "may not exist yet" check requires and no cheaper.
  function isValidCurrentZoneId(after) {
    return !('currentZoneId' in after) || after.currentZoneId is string;
  }

  // Ownership-scoped like the rest of this file — the real validation (that
  // a flight's duration actually matches the zone-tier formula, see
  // gameData/travel.ts's travelMinutes) happens in firebase/travel.ts, the
  // only path that writes this field. A bare "is a map" check (not one
  // expression per sub-field) for the same expression-budget reason as
  // isValidCurrentZoneId above.
  function isValidTravel(after) {
    return !('travel' in after) || after.travel == null || after.travel is map;
  }

  // Ownership-scoped, not fully value-scoped — same posture as the sibling
  // maps below. Full validation (that an enchantment id is real, that a
  // disenchant/repair actually consumed the right materials) happens in
  // firebase/enchanting.ts / firebase/professions.ts, the only paths that
  // write these fields.
  function isValidEnchantments(after) {
    return !('enchantments' in after) || (after.enchantments is map && after.enchantments.size() <= 8);
  }

  function isValidLearnedRecipeIds(after) {
    return !('learnedRecipeIds' in after) || (after.learnedRecipeIds is list && after.learnedRecipeIds.size() <= 300);
  }

  // Only ever grows via a Tailoring-crafted bag (see
  // firebase/consumables.ts) — bounded well above anything reachable so a
  // genuine bag-capacity ceiling is never mistaken for a rules bug.
  function isValidBagSlots(after) {
    return !('bagSlots' in after) || (after.bagSlots is number && after.bagSlots >= 24 && after.bagSlots <= 500);
  }

  // Bounded 4-124 — see gameData/bank.ts's BASE_BANK_SLOTS/MAX_BANK_SLOTS.
  // Full validation (gold actually spent, one slot at a time) happens in
  // firebase/bank.ts's buyBankSlot, the only path that increases this.
  function isValidBankSlots(after) {
    return !('bankSlots' in after) || (after.bankSlots is number && after.bankSlots >= 4 && after.bankSlots <= 124);
  }

  // Capped at 7 — the number of BuffCategory values (gameData/types.ts) —
  // since at most one buff per category can ever be active at once.
  function isValidActiveBuffs(after) {
    return !('activeBuffs' in after) || (after.activeBuffs is map && after.activeBuffs.size() <= 7);
  }

  // Same "may not exist yet on an old character" treatment as Smithing/
  // Tailoring above — this field was added after some characters already
  // existed. Value-scoped only up to size (max 5 slots) — full validation
  // of "is this ability actually unlocked for this class/level" happens in
  // firebase/character.ts's setEquippedAbilities before the write is even
  // sent, matching this project's existing "ownership-scoped, not fully
  // value-scoped" security posture.
  function isValidEquippedAbilityIds(after) {
    return !('equippedAbilityIds' in after)
      || (after.equippedAbilityIds is list && after.equippedAbilityIds.size() <= 5);
  }

  // Same "may not exist yet on an old character" treatment, and the same
  // ownership-scoped (not fully value-scoped) posture as
  // isValidEquippedAbilityIds — full validation of condition shape/values/
  // "only for an equipped ability" happens in firebase/character.ts's
  // saveCombatSetup before the write is even sent.
  function isValidAbilityConditions(after) {
    return !('abilityConditions' in after)
      || (after.abilityConditions is map && after.abilityConditions.size() <= 5);
  }

  // Same "may not exist yet on an old character" treatment and ownership-
  // scoped posture as isValidEquippedAbilityIds — full validation that an id
  // here is actually equipped happens in firebase/character.ts's
  // saveCombatSetup before the write is even sent. Bounded the same as
  // equippedAbilityIds (at most 5 slots, so at most 5 can be toggled off).
  function isValidDisabledAbilityIds(after) {
    return !('disabledAbilityIds' in after)
      || (after.disabledAbilityIds is list && after.disabledAbilityIds.size() <= 5);
  }

  // Same "may not exist yet on an old character" treatment and the same
  // ownership-scoped posture as isValidEquippedAbilityIds/
  // isValidAbilityConditions above — full validation of each preset's shape
  // happens in firebase/character.ts's saveCombatPreset (the only path that
  // ever adds an entry), so this just bounds how many can exist. Keep this
  // 3 in sync with combatEngine/progression.ts's MAX_COMBAT_PRESETS.
  function isValidCombatPresets(after) {
    return !('combatPresets' in after)
      || (after.combatPresets is list && after.combatPresets.size() <= 3);
  }

  // Same "may not exist yet on an old character" treatment and ownership-
  // scoped posture as the sibling maps above — full validation (that a key
  // is an actual consumable item id, that the write only ever sets it to
  // now()) happens in firebase/consumables.ts, the only path that touches
  // this field. Bounded generously since this grows with the consumable
  // item catalog, not with player action.
  function isValidItemCooldowns(after) {
    return !('itemCooldowns' in after)
      || (after.itemCooldowns is map && after.itemCooldowns.size() <= 20);
  }

  // Same "may not exist yet on an old character" treatment as the sibling
  // fields above — full validation (that active quest ids are real, that
  // objective progress never exceeds a quest's own target, that rewards
  // match QuestDef) happens in gameData/questEngine.ts's applyQuestEvents,
  // the only path that ever writes this field. Bounded generously on
  // completedIds/dailyCompletedAt since those only grow with the quest
  // catalog, not with player action; active is capped at
  // gameData/quests.ts's MAX_ACTIVE_QUESTS.
  function isValidQuests(after) {
    return !('quests' in after)
      || (after.quests is map
          && after.quests.keys().hasOnly(['active', 'completedIds', 'dailyCompletedAt'])
          && after.quests.active is map && after.quests.active.size() <= 8
          && after.quests.completedIds is list && after.quests.completedIds.size() <= 200
          && after.quests.dailyCompletedAt is map && after.quests.dailyCompletedAt.size() <= 50);
  }

  // New-character quests: completedIds/dailyCompletedAt must be empty (a
  // fresh character has completed nothing yet), but active may already
  // hold up to MAX_ACTIVE_QUESTS starter quests — createCharacter() fills
  // it via refillActiveQuests() before the write, so a brand new character
  // sees its quest board immediately instead of an empty one.
  function isValidNewQuests(q) {
    return q is map
      && q.keys().hasOnly(['active', 'completedIds', 'dailyCompletedAt'])
      && q.active is map && q.active.size() <= 8
      && q.completedIds == []
      && q.dailyCompletedAt == {};
  }

  // Ownership-scoped, not fully value-scoped — same posture as the sibling
  // maps above. Full validation (that a companion id is real, that its gear
  // is something its class can wear) happens in firebase/companions.ts, the
  // only path that ever writes this field. Capped at the size of the
  // COMPANIONS roster (gameData/companions.ts) since a character can
  // recruit each one at most once.
  function isValidCompanions(after) {
    return !('companions' in after) || (after.companions is map && after.companions.size() <= 10);
  }

  // Must be a list of recruited companion ids, at most MAX_ACTIVE_COMPANIONS
  // (gameData/companions.ts) long — but "are these ids actually recruited"
  // is a cross-field check, not something this layer alone can verify
  // cheaply, so this only bounds the type/size and leaves full validation to
  // firebase/companions.ts's addCompanionToParty/removeCompanionFromParty,
  // same posture as every other companions field.
  function isValidActiveCompanionIds(after) {
    return !('activeCompanionIds' in after)
      || (after.activeCompanionIds is list && after.activeCompanionIds.size() <= 4);
  }

  // Ownership-scoped, not fully value-scoped — same posture as
  // isValidCombatPresets/isValidAbilityConditions/isValidItemCooldowns/
  // isValidQuests below (full validation, e.g. that a slot's value is a real
  // equippable item id the class can wear, happens in firebase/character.ts's
  // equipItem before the write is even sent). Deliberately NOT checking each
  // of the 7 slots individually with a per-field null-or-string branch: with
  // every slot non-null (a fully-geared character, the normal end state of
  // real play) that per-field branching was enough to trip Firestore's
  // 1000-expression-per-request rules evaluation limit on every single
  // combat/gather/craft autosave — a real, production-blocking bug, not an
  // emulator artifact.
  function isValidEquipment(e) {
    return e is map && e.keys().hasOnly(['weapon','offhand','chest','helmet','gloves','legs','boots','ring','ring2','necklace','tool']);
  }

  // weapon/chest/boots may already be filled at creation — createCharacter()
  // grants a small class-appropriate starter kit there (see gameData/items.ts's
  // "Starter gear" section) so a level-1 character isn't fighting bare-handed.
  // The remaining slots (helmet/gloves/legs/ring/ring2/necklace/offhand/tool)
  // the starter kit never touches, so those must still be empty on a
  // genuinely new character.
  function isValidNewEquipment(e) {
    return isValidEquipment(e)
      && e.helmet == null && e.gloves == null && e.legs == null && e.ring == null && e.ring2 == null
      && e.necklace == null && e.offhand == null && e.tool == null;
  }

  // A character now starts knowing NO professions at all (see
  // firebase/professions.ts's learnProfession) — professions is only ever
  // populated by explicit, server-validated learn/abandon/rank-up calls, so
  // this is ownership-scoped (bounds + shape only, not a per-entry
  // isValidProfessionState descent) — same posture as
  // isValidCombatPresets/isValidItemCooldowns/isValidQuests above. This used
  // to also validate each known profession's {level, xp, unlockedTier} shape
  // individually (10 extra function calls, unconditionally, on every single
  // write touching this character), which stacked with every other field's
  // own checks below closely enough to the 1000-expression-per-request
  // evaluation ceiling (see isValidEquipment's comment on this same limit)
  // that learning a profession could start failing with "insufficient
  // permissions" once a character's other state (gear, quests, companions)
  // had grown large enough — worse the more professions were already known,
  // so it surfaced as "I can learn some professions but not others" even
  // though nothing about any specific profession was actually invalid. A
  // profession can also be REMOVED (abandonProfession resets it entirely),
  // so there's deliberately no "never decreases" invariant here either —
  // re-learning after abandoning always restarts at level 1 anyway.
  function isValidProfessions(profs) {
    return profs is map
      && profs.size() <= 10
      && profs.keys().hasOnly(['herbalism','skinning','mining','fishing','alchemy','leatherworking','smithing','tailoring','enchanting','cooking']);
  }

  function isValidActivity(a) {
    return a.type in [null, 'combat', 'gathering', 'crafting', 'fishing']
      && (a.targetId == null || a.targetId is string)
      && (a.zoneId == null || a.zoneId is string)
      && (a.startedAt == null || a.startedAt is timestamp);
  }
}
