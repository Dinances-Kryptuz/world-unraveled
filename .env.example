# Copy this file to .env.local and fill in real values from your Firebase
# project settings (Project Settings > General > Your apps).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set to "true" to run entirely against the local Firebase emulators
# (auth + firestore) instead of a real project — no real credentials
# needed above when this is on. Start the emulators with:
#   npx firebase emulators:start
VITE_USE_FIREBASE_EMULATORS=false
